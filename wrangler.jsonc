{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "altmeter",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // run the password gate before serving any file
    "run_worker_first": true
  },
  "observability": { "enabled": true }
}
